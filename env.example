# .env.example
# -------------
# This file is committed to GitHub as a template — it shows what variables are
# needed but contains NO real credentials.
#
# Setup instructions:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real Snowflake values in .env
#   3. The .env file is gitignored and will never be committed to source control

# ---------------------------------------------------------------------------
# Snowflake credentials
# Used by dbt (profiles.yml) for local development and CI/CD runs.
# The Airflow connection (snowflake_default) is configured separately in the
# Airflow UI under Admin -> Connections and does not use these variables.
# ---------------------------------------------------------------------------

# Your Snowflake account identifier
# Format examples: xy12345.us-east-1  OR  orgname-accountname
DBT_SNOWFLAKE_ACCOUNT=your_account_identifier

# Snowflake login credentials
DBT_SNOWFLAKE_USER=your_username
DBT_SNOWFLAKE_PASSWORD=your_password

# Snowflake role with CREATE TABLE / INSERT privileges on EXOPLANETS_DB
DBT_SNOWFLAKE_ROLE=SYSADMIN

# Target database and warehouse
DBT_SNOWFLAKE_DATABASE=EXOPLANETS_DB
DBT_SNOWFLAKE_WAREHOUSE=COMPUTE_WH
